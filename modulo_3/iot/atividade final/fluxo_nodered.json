        "sessionExpiry": ""
    },
    {
        "id": "mqtt_in_tempdata",
        "type": "mqtt in",
        "z": "flow_iot_hivemq",
        "name": "Receber Tempdata",
        "topic": "Tempdata",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "broker_hivemq_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 180,
        "wires": [
            ["parse_csv_function", "debug_raw_msg"]
        ]
    },
    {
        "id": "parse_csv_function",
        "type": "function",
        "z": "flow_iot_hivemq",
        "name": "Parsear CSV (temp,hum,)",
        "func": "// Payload esperado: \"25.30,60.50,\"\nvar payload = msg.payload;\n\nif (typeof payload !== 'string') {\n    payload = payload.toString();\n}\n\n// Remove trailing comma and split\nvar parts = payload.replace(/,$/, '').split(',');\n\nif (parts.length >= 2) {\n    var temp = parseFloat(parts[0]);\n    var hum  = parseFloat(parts[1]);\n    \n    if (!isNaN(temp) && !isNaN(hum)) {\n        // Mensagem de temperatura\n        var msgTemp = { payload: temp, topic: 'temperatura' };\n        // Mensagem de umidade\n        var msgHum  = { payload: hum,  topic: 'umidade' };\n        // Mensagem completa\n        var msgAll  = {\n            payload: {\n                temperatura: temp,\n                umidade: hum,\n                timestamp: new Date().toISOString()\n            }\n        };\n        return [[msgTemp, msgHum], [msgAll]];\n    }\n}\n\n// Dados inválidos\nnode.warn('Payload inválido: ' + payload);\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 180,
        "wires": [
            ["debug_temp_hum"],
            ["debug_json_completo"]
        ]
    },
